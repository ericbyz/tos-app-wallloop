# WallLoop service environment (sourced by systemd EnvironmentFile)

# Admin surface (panel + management API) listen address.
# 127.0.0.1 ON PURPOSE: the panel is only reachable through the TOS desktop
# floating window (TOS nginx proxies /wallloop/ -> 127.0.0.1:18241 and sits
# behind TOS login). The management API (upload/delete/settings) needs no
# separate password because the raw port is not reachable from the LAN.
WALLLOOP_ADMIN_LISTEN=127.0.0.1:18241
WALLLOOP_ADMIN_PORT=18241

# Public surface (player page + media streaming + /api/v1/now + playlist).
# 0.0.0.0 ON PURPOSE: TVs / tablets / phones on the LAN open the player
# directly at http://<NAS>:18240/play — this is the dynamic-wallpaper
# endpoint. This surface is strictly read-only (management routes 404).
WALLLOOP_LISTEN=0.0.0.0:18240
WALLLOOP_PORT=18240

# App id (nginx route prefix /wallloop/, used in log lines)
WALLLOOP_APP_ID=wallloop

# Data directory: wallpaper library, thumbnails and state.json live here
WALLLOOP_DATA_DIR=/var/lib/wallloop

# ffmpeg from the TOS factory image (probing / thumbnails / demo synthesis)
WALLLOOP_FFMPEG=/usr/bin/ffmpeg

# Max size of a single upload (bytes); nginx location allows the same
WALLLOOP_MAX_UPLOAD_BYTES=4294967296
