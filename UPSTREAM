# Upstream project pin — single source of truth for reproducible builds.
# Parsed by scripts/fetch_upstream.sh and build.sh (KEY=VALUE, no spaces).
# Bump with: scripts/bump_upstream.sh <new-version>
#
# WallLoop is an ORIGINAL app: the "upstream" is our own source repository,
# which publishes cross-compiled release binaries (CGO_ENABLED=0, static).
# For local builds without a published release, set UPSTREAM_DIST_DIR to a
# directory containing the two pinned asset files; fetch_upstream.sh will
# use it instead of downloading from GitHub.

UPSTREAM_REPO=https://github.com/ericbyz/wallloop
UPSTREAM_LICENSE=Apache-2.0

# Pinned release tag and version (must equal config.ini "version")
UPSTREAM_TAG=v0.1.0
UPSTREAM_VERSION=0.1.0

# Pinned release assets per architecture (linux, CGO_ENABLED=0 static Go binaries)
ASSET_x86_64=wallloop_0.1.0_linux_amd64.tar.gz
ASSET_aarch64=wallloop_0.1.0_linux_arm64.tar.gz

# SHA256 of each pinned asset (verified by fetch_upstream.sh)
SHA256_x86_64=438d8c7569e2870d0a4b04c7e02416be058a654fcce118f788fb40c218bd3b10
SHA256_aarch64=e2e1f901a6660cd198736775cbfec970a3f14ffe30666fcafd376fa8943b3b11
